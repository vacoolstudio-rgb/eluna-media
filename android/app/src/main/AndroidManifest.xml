<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ gates the "batch finished" notice behind a runtime prompt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Keeps the process alive while a batch is converting. dataSync serves
         API 29–34; Android 15 time-boxes dataSync to ~6h/day, so API 35+
         starts as mediaProcessing — the type designated for transcoding. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING"/>

    <!-- There is deliberately no INTERNET permission here. The shipped build
         has no network access at all: conversion is local, and there are no
         ads, no analytics and no update checks. src/release/AndroidManifest.xml
         additionally strips it with tools:node="remove" so no dependency can
         merge it back in and quietly falsify the in-app network audit; the
         marker lives there and not here because the debug and profile
         manifests legitimately add the permission for hot reload. -->

    <!-- Saving into the gallery / public Downloads needs this only on old
         Androids; from API 29 on, MediaStore inserts are permission-free
         (29 itself may still run legacy external storage, hence inclusive). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>

    <application
        android:label="Eluna Media"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- MAIN/LAUNCHER deliberately does NOT live here: it belongs to
                 the <activity-alias> entries below, and moving it is what makes
                 an alternative icon possible at all. The activity itself stays
                 exported for the share and view filters, which keep working no
                 matter which alias is currently the launcher one. -->

            <!-- "Share to Eluna Media" from galleries, file managers, chats. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="audio/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="audio/*"/>
            </intent-filter>

            <!-- "Open with Eluna Media" for a media file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="audio/*"/>
            </intent-filter>
        </activity>
        <!-- Одна включённая запись на всё приложение: именно её иконку и имя
             рисует лаунчер. Переключение — `PackageManager.setComponentEnabledSetting`
             в MainActivity, и там сначала включается новая, потом гасятся
             остальные: если погасить последнюю включённую раньше, приложение
             пропадает с рабочего стола, а на части прошивок — и из недавних.

             Иконка по умолчанию `loop` включена здесь и совпадает с
             `android:icon` у <application> — тем, что видит человек, поставивший
             приложение впервые.

             Список обязан совпадать с `kAppIcons` в lib/domain/app_icons.dart и
             с ресурсами, которые собирает tool/gen_app_icons.py. -->

        <activity-alias
            android:name=".IconLoop"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="Eluna Media"
            android:icon="@mipmap/ic_launcher_loop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconPetals"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Eluna Media"
            android:icon="@mipmap/ic_launcher_petals">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconToolbox"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Eluna Media"
            android:icon="@mipmap/ic_launcher_toolbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconNeon"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Eluna Media"
            android:icon="@mipmap/ic_launcher_neon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconOrbit"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Eluna Media"
            android:icon="@mipmap/ic_launcher_orbit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconUnbox"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Eluna Media"
            android:icon="@mipmap/ic_launcher_unbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconClamp"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Eluna Media"
            android:icon="@mipmap/ic_launcher_clamp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconEnvelope"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Eluna Media"
            android:icon="@mipmap/ic_launcher_envelope">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconSatchel"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Eluna Media"
            android:icon="@mipmap/ic_launcher_satchel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <service
            android:name=".ConversionForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
